<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quantity_Greater_Than_Zero</fullName>
    <active>true</active>
    <description>Quantity_Greater_Than_Zero</description>
    <errorConditionFormula>Quantity__c  &gt; 0</errorConditionFormula>
    <errorDisplayField>Quantity__c</errorDisplayField>
    <errorMessage>Quantity must be greater than zero.</errorMessage>
</ValidationRule>
